          "name": "Admin - Получение списка Comment по параметрам",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "const baseUrl = pm.collectionVariables.get(\"baseUrl\") || \"http://localhost:8080\";",
                  "const randomSuffix = Math.floor(Math.random() * 10000);",
                  "const user = {name: \"User\" + randomSuffix, email: `user${randomSuffix}@mail.com`};",
                  "const category = {name: \"Category\" + randomSuffix};",
                  "const event = {",
                  "    annotation: \"AnnotationAnnotation\" + randomSuffix,",
                  "    description: \"DescriptionDescription\" + randomSuffix,",
                  "    eventDate: new Date(Date.now() + 36000000).toISOString().replace(\"T\", \" \").substring(0, 19),",
                  "    location: {\"lat\": 55.75, \"lon\": 37.61},",
                  "    paid: false,",
                  "    participantLimit: 0,",
                  "    requestModeration: false,",
                  "    title: \"Event\" + randomSuffix,",
                  "    category: category.id",
                  "};",
                  "const comment = {comment: \"Test comment\"};",
                  "",
                  "pm.collectionVariables.set(\"baseUrl\", baseUrl);",
                  "",
                  "const send = (options) => new Promise((resolve, reject) => {",
                  "    pm.sendRequest(options, (err, res) => {",
                  "        if (err) return reject(err);",
                  "        resolve(res);",
                  "    });",
                  "});",
                  "",
                  "(async () => {",
                  "    try {",
                  "        let resUser = await send({url: baseUrl + \"/admin/users\", method: \"POST\", header: {\"Content-Type\": \"application/json\"}, body: {mode: \"raw\", raw: JSON.stringify(user)}});",
                  "        let userId = resUser.json().id;",
                  "        pm.collectionVariables.set(\"userId\", userId);",
                  "",
                  "        let resCategory = await send({url: baseUrl + \"/admin/categories\", method: \"POST\", header: {\"Content-Type\": \"application/json\"}, body: {mode: \"raw\", raw: JSON.stringify(category)}});",
                  "        let categoryId = resCategory.json().id;",
                  "        pm.collectionVariables.set(\"categoryId\", categoryId);",
                  "",
                  "        event.category = categoryId;",
                  "        let resEvent = await send({url: baseUrl + `/users/${userId}/events`, method: \"POST\", header: {\"Content-Type\": \"application/json\"}, body: {mode: \"raw\", raw: JSON.stringify(event)}});",
                  "        let eventId = resEvent.json().id;",
                  "        pm.collectionVariables.set(\"eventId\", eventId);",
                  "",
                  "        await send({url: baseUrl + `/admin/events/${eventId}`, method: \"PATCH\", header: {\"Content-Type\": \"application/json\"}, body: {mode: \"raw\", raw: JSON.stringify({stateAction: \"PUBLISH_EVENT\"})}});",
                  "",
                  "        let resComment = await send({url: baseUrl + `/comments/${userId}/${eventId}`, method: \"POST\", header: {\"Content-Type\": \"application/json\"}, body: {mode: \"raw\", raw: JSON.stringify(comment)}});",
                  "        let commentId = resComment.json().id;",
                  "        pm.collectionVariables.set(\"commentId\", commentId);",
                  "    } catch (e) {",
                  "        pm.expect.fail(\"Ошибка подготовки данных: \" + e);",
                  "    }",
                  "})();",
                  ""
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"Проверка статус-кода\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  ""
                ]
              }
            }
